        "mgu-inputgate": "1.1.0"
      },
      "build": {
        "python": "tools/install-korean.py",
        "args": [
          "--id",
          "{id}",
          "--version",
          "{version}",
          "--dir",
          "{dir}"
        ],
        "network": false,
        "shared": [
          "tools/install-korean.py",
