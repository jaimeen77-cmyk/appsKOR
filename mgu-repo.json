{
  "schema": 1,
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU 화면 렌더러",
      "description": "앱 화면을 초당 60프레임으로 그리는 필수 렌더러이며 iDrive 7과 iDrive 8에서 앱과 함께 설치됩니다.",
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/inputgate/tool",
      "title": "iDrive 컨트롤러 연결",
      "description": "iDrive 7과 iDrive 8에서 탭·화면 버튼·설정·Doom을 컨트롤러로 조작하게 하며 다음 HMI 시작 시 적용됩니다.",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    }
  ],
