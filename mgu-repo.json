{
  "schema": 1,
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU 화면 렌더러",
      "description": "앱 화면을 초당 60프레임으로 그리는 필수 렌더러이며 앱과 함께 설치됩니다.",
      "provides": "renderer",
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/prebuilt",
      "version": "1.0.0",
      "title": "iDrive 컨트롤러 연결",
      "description": "탭·화면 버튼·설정·Doom에서 iDrive 컨트롤러를 사용할 수 있게 하며 다음 HMI 시작 시 적용됩니다.",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "mguHmi": [
        "ID7"
      ],
      "preload": {
        "library": "mgu-inputgate.so",
        "unit": "hmi.service",
        "process": "HmiMain3D",
        "strikes": 2,
        "checkAfterSeconds": 120,
        "healthySeconds": 60
      }
    }
  ],
  "components": [
    {
      "id": "ambient_config",
      "kind": "app",
      "path": "store/apps/ambient_config",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "mgu-deploy": "0.7.17",
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "tools/install-korean.py",
        "args": [
          "--id",
          "{id}",
          "--version",
          "{version}",
          "--dir",
          "{dir}"
        ],
        "network": false,
        "shared": [
          "tools/install-korean.py",
          "store/korean/common",
          "store/korean/ambient_config"
        ]
      }
    },
