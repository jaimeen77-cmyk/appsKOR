{
  "schema": 1,
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU renderer",
      "description": "The apps' own GPU renderer (mgu-render): draws them at 60 fps, beside the MGU Store's Renderer; installed with the apps",
      "provides": "renderer",
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/prebuilt",
      "version": "1.0.0",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "mguHmi": [
        "ID7"
      ],
      "preload": {
        "library": "mgu-inputgate.so",
        "unit": "hmi.service",
        "process": "HmiMain3D",
        "strikes": 2,
        "checkAfterSeconds": 120,
        "healthySeconds": 60
      }
    }
  ],
  "components": [
    {
      "id": "ambient_config",
      "kind": "app",
      "path": "store/apps/ambient_config",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "mgu-deploy": "0.7.17",
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "tools/install-korean.py",
        "args": [
          "--id",
          "{id}",
          "--version",
          "{version}",
          "--dir",
          "{dir}"
        ],
        "network": false,
        "shared": [
          "tools/install-korean.py",
          "store/korean/common",
          "store/korean/ambient_config"
        ]
      }
    },
